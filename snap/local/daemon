#!/bin/sh
# Keep the nftables rules in sync with the snap configuration.
#
# The firewall-control interface is not auto-connected, so the first
# apply attempts may fail until the user runs:
#   sudo snap connect roscaelum:firewall-control
# Retry periodically and re-apply whenever the configuration changes.
set -u

CONFIG="${ROSCAELUM_CONFIG:-$SNAP_DATA/roscaelum.yml}"
LAST=""

while :; do
    if [ -f "$CONFIG" ]; then
        SUM="$(sha256sum "$CONFIG" | cut -d' ' -f1)"
        if [ "$SUM" != "$LAST" ]; then
            if "$SNAP/bin/rcfctl" -f "$CONFIG" apply; then
                LAST="$SUM"
            fi
        fi
    fi
    sleep 15
done
